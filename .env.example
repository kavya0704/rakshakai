# ==========================================
# RAKSHAK AI — ENVIRONMENT CONFIGURATION
# ==========================================

# Groq Cloud LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_TIMEOUT_SECONDS=10

# Security & Authentication
APP_ENV=development
APP_SECRET_KEY=rakshak_ai_secret_key_change_in_prod
JWT_SECRET=rakshak_jwt_secret_key_sih_2026
JWT_EXPIRE_HOURS=8

# Database (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://rakshak:demo_password@localhost:5432/rakshak_ai

# CORS & Network
FRONTEND_ORIGIN=http://localhost:3000

# Simulation Configuration
SIMULATION_AUTO_START=false
SIMULATION_INTERVAL_SECONDS=30
CORRELATION_TIME_WINDOW_SECONDS=600
CORRELATION_MIN_SOURCES=2

# Computer Vision
CV_ENABLED=false
CV_CONFIDENCE_THRESHOLD=0.5
